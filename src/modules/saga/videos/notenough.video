# notenough.video — "Not Enough → Enough"  (emotional wordless build, per the visual-storytelling skill)
# ============================================================================
# Story (kishōtenketsu, conflict-free): Little One feels small beside a dazzling light, strains to BE
# it and fails, slumps at a mirror expecting nothing — then sees the warm glow it was casting all along.
# It was already enough.  ONE feeling: not-enough → enough.  The TURN is beat 4 (the reveal), landed on
# the music swell.  Color ARC: cool/lonely (beats 1-3) → warm/full (beats 4-6).  Music-led, no voice.
#
# Curate 6 START keyframes shots/shot1..6.png + 1 END keyframe shots/shot4_end.png (the glow reveal,
# made from shot4.png with `saga-flux --init shot4.png --denoise 0.5 …`). Drop enough_bed.wav +
# endcard_src.png in the workdir. Then: saga-video.sh -c notenough.video --plan  → then run.

TITLE="Not Enough → Enough"

LORA=little_one_v2.safetensors; LORA_STR=0.9; GUIDANCE=3.5; STEPS=28
VID_W=640; VID_H=1120; FPS=30; GPU_KEEP=8; TEACACHE=0

# post: default warm; per-beat GRADE_AT paints the cold→warm arc (lonely cool → warm payoff)
GRADE=soft-heavy; UPSCALE=1920; XFADE=0.7
GRADE_AT=( "soft-cool" "soft-cool" "soft-cool" "soft-heavy" "soft-heavy" "soft-heavy" )

ENDCARD_IMG=endcard_src.png; ENDCARD_SEC=2
MUSIC=enough_bed.wav; MUSIC_DB=-16

# no voice (music-led). Fill VO=() to narrate.
VOICE=af_heart; VOICE_SPEED=0.9; VO_LEAD=0.2
VO=()
VO_ENDCARD=""

# varied durations: holds (take b3, afterglow b6) and the reveal (b4) get room; peak is slowest.
DUR=(4 4 3 4 3 4)

# beat 4 is the REVEAL (dull reflection → the warm glow blooms): FLF shot4 → shot4_end
REVEAL=( "" "" "" "reveal" "" "" )

# START-keyframe reference prompts. IDENTITY IS PINNED by a fixed character block repeated verbatim
# every beat (consistency must come from the POSITIVE prompt — Flux-dev ignores negatives at cfg 1.0).
# Do NOT ask for anatomy the blob lacks (stretch tall / tiptoe / reach far) or it drifts lanky/human —
# effort is shown as PUFFING UP ROUNDER, not stretching. Round pear build · stub limbs · no tail ·
# smooth matte skin · a 3-strand tuft — stated positively (negations are unreliable in the prompt).
IMG_PROMPT=(
"l1ttl3one, a small round pear-shaped creature, chubby rounded body wider at the bottom, big glossy black eyes, soft rosy cheeks, tiny short stub arms and tiny stub legs, smooth soft matte charcoal-grey skin, a tiny tuft of exactly three thin hair strands on top of the head, very small at the bottom of a tall frame gazing up wistfully at a bright dazzling glowing shape drifting high above, tuft drooped, lonely, vast empty cool space above, cool desaturated blue moonlight, moody hand-drawn charcoal, no text"
"l1ttl3one, a small round pear-shaped creature, chubby rounded body wider at the bottom, big glossy black eyes, soft rosy cheeks, tiny short stub arms and tiny stub legs, smooth soft matte charcoal-grey skin, a tiny tuft of exactly three thin hair strands on top of the head, puffing itself up rounder and glowing faintly, straining to shine as bright as the distant light, hopeful effort, cool dim blue light, moody hand-drawn charcoal, no text"
"l1ttl3one, a small round pear-shaped creature, chubby rounded body wider at the bottom, big glossy black eyes, soft rosy cheeks, tiny short stub arms and tiny stub legs, smooth soft matte charcoal-grey skin, a tiny tuft of exactly three thin hair strands on top of the head, slumped low and small sitting in front of a soft dark oval mirror, head lowered, cool desaturated blue shadow, low key, moody hand-drawn charcoal, no text"
"l1ttl3one, a small round pear-shaped creature, chubby rounded body wider at the bottom, big glossy black eyes, soft rosy cheeks, tiny short stub arms and tiny stub legs, smooth soft matte charcoal-grey skin, a tiny tuft of exactly three thin hair strands on top of the head, sitting before an oval mirror with a dim plain grey reflection, cool low blue light, moody hand-drawn charcoal, no text — (end keyframe shot4_end: a soft warm golden glow revealed radiating from its own body and around it in the reflection, eyes widening in wonder, warm amber bloom, cheeks catching gold)"
"l1ttl3one, a small round pear-shaped creature, chubby rounded body wider at the bottom, big glossy black eyes, soft rosy cheeks, tiny short stub arms and tiny stub legs, smooth soft matte charcoal-grey skin, a tiny tuft of exactly three thin hair strands on top of the head, sitting up a little and touching a soft warm golden glow around itself, rosy cheeks, quiet contentment, warm amber light, moody hand-drawn charcoal, no text"
"l1ttl3one, a small round pear-shaped creature, chubby rounded body wider at the bottom, big glossy black eyes, soft rosy cheeks, tiny short stub arms and tiny stub legs, smooth soft matte charcoal-grey skin, a tiny tuft of exactly three thin hair strands on top of the head, glowing softly warm and full, looking gently toward the viewer, peaceful, rosy cheeks, warm amber light, moody hand-drawn charcoal, no text"
)

# motion per beat: speed word (eased), anticipation, a secondary action, follow-through, aliveness,
# and a verb-of-becoming on the reveal.
MOTION=(
"the small round creature slowly gazes up following the drifting bright light, then lowers its gaze to itself and gently deflates, tuft drooping, a slow sad blink, very slow gentle motion, cool still air, static camera"
"the small round creature puffs itself up rounder and glows faintly, straining to shine, then softly deflates back to its small round self and tries once more, endearing effort, eased squash and stretch, tuft settling a moment after, static camera"
"the small round creature settles down in front of the mirror and slumps with a heavy sigh, then goes completely still, wide quiet eyes, only a slow breath and one slow blink, a held stillness, static camera"
"a soft warm golden glow slowly blooms and radiates from the small round creature's own body and around it in the reflection, its eyes widen in dawning wonder, warm amber light gently spreading and brightening, tender slow motion of becoming, static camera"
"the small round creature gently rounds up warmly and softly touches the glow around itself, its cheeks warming rosy, a soft contented settle, warm light steadying, eased motion, static camera"
"the small round creature rests softly, glowing warm and full, a slow gentle breath and a soft calm blink, looking gently toward the viewer, warm amber light holding steady, very slow motion, static camera"
)

# captions: silent until the resonance — one shareable line on the afterglow (the "heart" frame)
CAPTION=( "" "" "" "" "" "you were always enough." )

VO_OFFSET=( "" "" "" "" "" "" )
