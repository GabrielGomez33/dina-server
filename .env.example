# ============================================================================
# DINA SERVER — ENVIRONMENT TEMPLATE
# ============================================================================
# Copy to .env (gitignored) and fill in real values. Values that name
# infrastructure or secrets are NEVER committed. Registry with consumers,
# defaults, and effect timing: src/modules/saga/docs/ENVIRONMENT.md
# (Pre-existing variables — DB_*, REDIS_URL, DINA_PORT, TLS paths, DINA_*
#  LLM tuning — continue to live in your real .env as they always have.)
# ============================================================================

# ---- SAGA (image/video generation limb) ----
# REQUIRED. Absolute root of SAGA storage on the dedicated SSD.
# The saga module degrades (isolated, non-fatal) with a clear error if unset.
SAGA_ROOT=/absolute/path/to/saga/storage

# ---- GPU arbiter (cross-engine VRAM scheduler) ----
# off = dark launch (registered, zero request-path change) | on = enforcing.
# Flipping back to off + pm2 reload is the instant rollback.
DINA_GPU_ARBITER=off
# VRAM headroom (MB) the arbiter always keeps free. Read once at startup.
DINA_GPU_RESERVE_MB=512

# ---- AUTH (DINA console user accounts) ----
# The ONE secret to set. Generate it with:
#   openssl rand -hex 32
# This is dina-server's own .env (no other module here reads JWT_SECRET, so
# there's no collision with mirror-server). The refresh-signing key is derived
# from this value automatically — you don't need a second secret. Must be
# >=32 chars; a short value returns a clear 503 (never a crash).
JWT_SECRET=
# OPTIONAL — set only if you want the refresh key fully independent of JWT_SECRET
# (otherwise it's derived). Must be >=32 chars and different from JWT_SECRET.
# JWT_REFRESH_SECRET=
#
# If JWT_SECRET is left blank, DINA self-generates + persists secrets (0600) at
# <DINA_STORAGE_ROOT>/auth/jwt-secrets.json so a fresh box still boots. Override
# the path with DINA_AUTH_SECRETS_FILE if needed.
# DINA_STORAGE_ROOT=/var/www/dina-storage
#
# Token lifetimes. Access is short (re-minted via /auth/refresh); refresh bounds
# how long a device stays signed in.
AUTH_ACCESS_TOKEN_EXPIRY=15m
AUTH_REFRESH_TOKEN_EXPIRY=7d
# bcrypt cost factor (10–15). 12 is a good default.
AUTH_BCRYPT_ROUNDS=12
# Absolute base URL of the DINA frontend — used to build verify/reset links in
# emails. No trailing slash. (Prod example shown.)
AUTH_APP_BASE_URL=https://www.theundergroundrailroad.world/dina
# Transactional email. 'console' (default) just logs the link — perfect for dev
# and safe by default (no accidental real sends). 'resend' posts to Resend.
AUTH_EMAIL_PROVIDER=console
RESEND_API_KEY=
AUTH_EMAIL_FROM=DINA <no-reply@theundergroundrailroad.world>

# ============================================================================
# STAGING OVERRIDES  (same-host, isolated staging dina-server — see docs/STAGING.md)
# ----------------------------------------------------------------------------
# A staging dina-server on the SAME host MUST use its own port, DB, storage roots,
# Redis keyspace and auth secret so it can never touch production data. It SHARES
# the host's single GPU and Ollama (Ollama serialises requests, so a low-volume
# staging is safe). Set these in the STAGING checkout's .env:
#
#   DINA_PORT=9445                          # prod is 8445
#   DB_NAME=dina_staging                    # a SEPARATE database (own user/pw)
#   REDIS_DB=2                              # a DIFFERENT logical index from prod
#   DINA_STORAGE_ROOT=/var/www/staging/dina-storage
#   SAGA_ROOT=/var/www/staging/saga-storage
#   JWT_SECRET=<openssl rand -hex 32>       # DISTINCT from prod (own console users)
#   DINA_ENCRYPTION_KEY=<distinct>          # never share prod's
#   TUGRRPRIV/TUGRRCERT/TUGRRINTERCERT      # reuse prod certs (loopback listener)
#   OLLAMA_BASE_URL=<same as prod>          # shared Ollama/GPU
#   DINA_CHAT_MODEL=<same as prod>          # e.g. mistral:7b
#   DINA_GPU_ARBITER=off                    # avoid contending prod for VRAM at first
#
#   # DINA calls BACK to mirror-server — point staging DINA at mirror-STAGING so
#   # the two staging services talk only to each other:
#   MIRROR_SERVER_URL=https://127.0.0.1:9444
#   MIRROR_SERVER_API_KEY=<mirror-staging's key>   # must match mirror-staging
#   MIRROR_SERVICE_KEY=<mirror-staging's key>      # must match mirror-staging
# ============================================================================
